// SGO - Sistema de Gestión
// Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  apellido    String
  nombre      String
  expediente  String?  @unique
  cod         String?  @unique
  password    String
  status      String   @default("active")
  accessLevel String   @default("user") @map("access_level")
  registered  Int      @default(1)
  image       String?
  signature   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

model Dato {
  id                 Int       @id @default(autoincrement())
  cod                String    @unique
  apellido           String
  nombre             String
  domicilioLegal     String?   @map("domicilio_legal")
  postalLegal        String?   @map("postal_legal")
  localidadLegal     String?   @map("localidad_legal")
  telefonosLegal     String?   @map("telefonos_legal")
  emailLegal         String?   @map("email_legal")
  expediente         String?
  folio              String?
  tipo               String?
  documento          String?
  tomo               String?
  domicilioReal      String?   @map("domicilio_real")
  postalReal         String?   @map("postal_real")
  localidadReal      String?   @map("localidad_real")
  codMovilLegal      String?   @map("cod_movil_legal")
  movilLegal         String?   @map("movil_legal")
  telefonosReal      String?   @map("telefonos_real")
  codMovilReal       String?   @map("cod_movil_real")
  movilReal          String?   @map("movil_real")
  emailReal          String?   @map("email_real")
  provinciaReal      String?   @map("provincia_real")
  fechaMatriculacion DateTime? @map("fecha_matriculacion")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("datos")
}

model Deuda {
  id         Int    @id @default(autoincrement())
  expediente String
  monto      Float

  @@map("deudas")
}

model MatriculaAnual {
  id         Int    @id @default(autoincrement())
  expediente String
  monto      Float

  @@map("matricula_anual")
}

model MatriculaMensual {
  id         Int    @id @default(autoincrement())
  expediente String
  monto      Float

  @@map("matricula_mensual")
}


model PagoAnual {
  id         Int    @id @default(autoincrement())
  expediente String

  @@map("pago_anual")
}

model Solicitud {
  id              Int      @id @default(autoincrement())
  expediente      String
  tipo            String // Ejemplo: "Certificado de Matriculación", "SISFE", etc.
  fecha           DateTime @default(now())
  estado          String   @default("pendiente") // pendiente, completada, rechazada
  presentarAnte   String?
  emailLegal      String?
  adjunto         String?  // Ruta o URL del archivo adjunto (PDF/Imagen)
  detalles        Json?    // Para guardar datos específicos como CUIT
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("solicitudes")
}

model AdhesionDebito {
  id              Int      @id @default(autoincrement())
  expediente      String
  tipoAdhesion    String   // "CBU" o "Tarjeta"
  estado          String   @default("pendiente") // pendiente, aprobada, rechazada
  dniFrontal      String?  // Ruta o URL del archivo
  constanciaCbu   String?  // Ruta o URL del archivo (Solo para CBU)
  frontalTarjeta  String?  // Ruta o URL del archivo (Solo para Tarjeta)
  terminosAceptados Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("adhesiones_debito")
}

model Curso {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String
  fecha       String   // "15 de Marzo, 2024" o similar para simpleza
  hora        String?  // Opcional
  cupo        Int
  inscritos   Int      @default(0)
  precio      String?  // Ejemplo: "Gratis" o "$1500"
  modalidad   String   @default("Presencial") // Presencial / Virtual
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cursos")
}

model InscripcionCurso {
  id          Int      @id @default(autoincrement())
  expediente  String
  cursoId     Int      @map("curso_id")
  fecha       DateTime @default(now())

  @@map("inscripciones_cursos")
}

model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  fecha       DateTime
  tipo        String   @default("institucional") // institucional, social, feriado, curso
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("eventos")
}
