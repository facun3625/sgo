generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int       @id @default(autoincrement())
  apellido       String
  nombre         String
  expediente     String?   @unique
  cod            String?   @unique
  password       String
  status         String    @default("active")
  accessLevel    String    @default("user") @map("access_level")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  registered     Int       @default(1)
  image          String?
  signature      String?
  permisos       String    @default("[]")
  suspendedUntil DateTime? @map("suspended_until")
  delegacionId   Int?         @map("delegacion_id")
  delegacion     Delegacion?  @relation(fields: [delegacionId], references: [id])

  @@map("users")
}

// Oficina/sucursal regional del colegio que actúa como cobrador en efectivo
// (cuota mensual, matrícula anual y deudas). Cada Delegación tiene un único
// User asociado (login) — el superadmin la crea desde /admin/delegaciones.
model Delegacion {
  id        Int      @id @default(autoincrement())
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  // Modelada como 1:N a nivel de Prisma (sin @unique en delegacionId para no
  // requerir --accept-data-loss al agregar la columna); el "1 usuario por
  // delegación" se garantiza en la API al crear (POST /api/admin/delegaciones).
  usuarios  User[]
  // Número de zona (columna "ZONA (Adic.)" del Excel de deudas) que le
  // corresponde a esta oficina — determina qué matriculados ve el cobrador.
  zona      String?

  @@map("delegaciones")
}

model Dato {
  id                 Int       @id @default(autoincrement())
  cod                String    @unique
  apellido           String
  nombre             String
  domicilioLegal     String?   @map("domicilio_legal")
  postalLegal        String?   @map("postal_legal")
  localidadLegal     String?   @map("localidad_legal")
  telefonosLegal     String?   @map("telefonos_legal")
  emailLegal         String?   @map("email_legal")
  expediente         String?
  folio              String?
  tipo               String?
  documento          String?
  tomo               String?
  domicilioReal      String?   @map("domicilio_real")
  postalReal         String?   @map("postal_real")
  localidadReal      String?   @map("localidad_real")
  codMovilLegal      String?   @map("cod_movil_legal")
  movilLegal         String?   @map("movil_legal")
  telefonosReal      String?   @map("telefonos_real")
  codMovilReal       String?   @map("cod_movil_real")
  movilReal          String?   @map("movil_real")
  emailReal          String?   @map("email_real")
  provinciaReal      String?   @map("provincia_real")
  fechaMatriculacion DateTime? @map("fecha_matriculacion")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  cuil               String?
  // Zona/subzona del expediente (columnas "ZONA"/"SUBZONA (Adic.)" del Excel
  // de deudas) — se actualiza en cada import de deudas, pero queda guardado
  // acá (a diferencia de DeudaComprobante) para no perderse si el expediente
  // salda su deuda y desaparece del próximo import. Determina qué Delegación
  // ve a este matriculado.
  zona               String?
  subzona            String?

  @@map("datos")
}

model Deuda {
  id         Int    @id @default(autoincrement())
  expediente String
  monto      Float

  @@map("deudas")
}

// Detalle de comprobantes que componen la deuda de cada expediente (import de
// "Ventas - Cuenta Corriente - Deudas vencidas.xlsx"). Deuda.monto sigue siendo
// la suma total y es lo único que usa el resto del sistema (pagos, PayWay, MP);
// esta tabla es solo para mostrar de qué se compone esa deuda.
model DeudaComprobante {
  id               Int      @id @default(autoincrement())
  expediente       String
  fechaVencimiento DateTime @map("fecha_vencimiento")
  monto            Float
  clienteNumero    String?  @map("cliente_numero")
  zona             String?
  subzona          String?

  @@index([expediente])
  @@map("deuda_comprobantes")
}

model DeudaPagada {
  id          Int      @id @default(autoincrement())
  expediente  String
  monto       Float
  mpPaymentId String?  @map("mp_payment_id")
  paywayPaymentId String? @map("payway_payment_id")
  metodoPago  String   @default("mercadopago")
  fechaPago   DateTime @default(now()) @map("fecha_pago")
  exportado   Boolean  @default(false)
  createdAt   DateTime @default(now())
  delegacionId        Int?    @map("delegacion_id")
  comprobanteEfectivo String? @map("comprobante_efectivo")

  @@index([expediente])
  @@map("deudas_pagadas")
}

model Config {
  id        Int      @id @default(autoincrement())
  clave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt

  @@map("config")
}

model CuotaMensual {
  id          Int       @id @default(autoincrement())
  expediente  String
  periodo     String
  monto       Float
  estado      String    @default("pendiente")
  fechaPago   DateTime?
  createdAt   DateTime  @default(now())
  metodoPago  String?
  exportado   Boolean   @default(false)
  mpPaymentId String?   @map("mp_payment_id")
  paywayPaymentId String? @map("payway_payment_id")
  delegacionId        Int?    @map("delegacion_id")
  comprobanteEfectivo String? @map("comprobante_efectivo")

  @@unique([expediente, periodo])
  @@map("cuotas_mensuales")
}

model PagoAnual {
  id          Int       @id @default(autoincrement())
  expediente  String
  exportado   Boolean   @default(false)
  fechaPago   DateTime?
  mpPaymentId String?   @map("mp_payment_id")
  paywayPaymentId String? @map("payway_payment_id")
  monto               Float?
  metodoPago          String? @map("metodo_pago")
  delegacionId        Int?    @map("delegacion_id")
  comprobanteEfectivo String? @map("comprobante_efectivo")

  @@map("pago_anual")
}

model Solicitud {
  id            Int      @id @default(autoincrement())
  expediente    String
  tipo          String
  fecha         DateTime @default(now())
  estado        String   @default("pendiente")
  presentarAnte String?
  emailLegal    String?
  detalles      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  adjunto       String?

  @@map("solicitudes")
}

model AdhesionDebito {
  id                Int      @id @default(autoincrement())
  expediente        String
  tipoAdhesion      String
  estado            String   @default("pendiente")
  dniFrontal        String?
  constanciaCbu     String?
  frontalTarjeta    String?
  terminosAceptados Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  motivo            String?

  @@map("adhesiones_debito")
}

model Curso {
  id                     Int                @id @default(autoincrement())
  titulo                 String
  descripcion            String
  hora                   String?
  modalidad              String             @default("Presencial")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  activo                 Boolean            @default(true)
  fechaLimiteInscripcion DateTime?
  imagen                 String?
  lugar                  String?
  organizador            String?
  fecha                  DateTime
  fechaFin               DateTime?
  mostrarEnCalendario    Boolean            @default(false)
  certCabecera           String?            @map("cert_cabecera")
  certFirmasIds          Int[]              @default([]) @map("cert_firmas_ids")
  certTexto              String?            @map("cert_texto")
  diasMinimos            Int?               @map("dias_minimos")
  porcentajeMin          Float?             @map("porcentaje_min")
  tipoAsistencia         String             @default("ninguna") @map("tipo_asistencia")
  abiertoNoMatriculados  Boolean            @default(false) @map("abierto_no_matriculados")
  certificados           CertificadoCurso[]
  dias                   CursoDia[]
  opciones               CursoOpcion[]
  inscripciones          InscripcionCurso[]
  sesiones               SesionAsistencia[]

  @@map("cursos")
}

model CursoDia {
  id        Int                @id @default(autoincrement())
  cursoId   Int                @map("curso_id")
  fecha     DateTime
  nombre    String?
  orden     Int                @default(0)
  createdAt DateTime           @default(now())
  curso     Curso              @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  sesiones  SesionAsistencia[]

  @@map("curso_dias")
}

model SesionAsistencia {
  id          Int               @id @default(autoincrement())
  cursoId     Int               @map("curso_id")
  diaId       Int?              @map("dia_id")
  token       String            @unique @default(uuid())
  activa      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  asistencias AsistenciaCurso[]
  curso       Curso             @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  dia         CursoDia?         @relation(fields: [diaId], references: [id])

  @@map("sesiones_asistencia")
}

model AsistenciaCurso {
  id         Int              @id @default(autoincrement())
  sesionId   Int              @map("sesion_id")
  expediente String
  createdAt  DateTime         @default(now())
  sesion     SesionAsistencia @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@unique([sesionId, expediente])
  @@map("asistencias_cursos")
}

model CertificadoCurso {
  id         Int      @id @default(autoincrement())
  expediente String
  cursoId    Int      @map("curso_id")
  emitidoAt  DateTime @default(now())
  curso      Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([expediente, cursoId])
  @@map("certificados_cursos")
}

model CursoOpcion {
  id                 Int                @id @default(autoincrement())
  cursoId            Int                @map("curso_id")
  nombre             String
  precio             Float              @default(0)
  precioNoMatriculado Float?            @map("precio_no_matriculado")
  cupo               Int                @default(0)
  inscritos          Int                @default(0)
  createdAt          DateTime           @default(now())
  infoPrivada        String?            @map("info_privada")
  curso              Curso              @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  inscripciones      InscripcionCurso[]

  @@map("curso_opciones")
}

model InscripcionCurso {
  id           Int          @id @default(autoincrement())
  expediente   String
  cursoId      Int          @map("curso_id")
  fecha        DateTime     @default(now())
  estado       String       @default("pendiente_pago")
  metodoPago   String?      @map("metodo_pago")
  opcionId     Int?         @map("opcion_id")
  fechaPago    DateTime?    @map("fecha_pago")
  mpPaymentId  String?      @map("mp_payment_id")
  paywayPaymentId String?   @map("payway_payment_id")
  esInvitado   Boolean      @default(false) @map("es_invitado")
  guestNombre  String?      @map("guest_nombre")
  guestApellido String?     @map("guest_apellido")
  guestEmail   String?      @map("guest_email")
  guestTelefono String?     @map("guest_telefono")
  guestDni     String?      @map("guest_dni")
  guestDireccion String?    @map("guest_direccion")
  guestLocalidad String?    @map("guest_localidad")
  guestProvincia String?    @map("guest_provincia")
  curso        Curso        @relation(fields: [cursoId], references: [id])
  opcion       CursoOpcion? @relation(fields: [opcionId], references: [id])

  @@map("inscripciones_cursos")
}

model Noticia {
  id        Int      @id @default(autoincrement())
  titulo    String
  contenido String
  imagen    String?
  activa    Boolean  @default(true)
  destacada Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  imagenes  String[] @default([])

  @@map("noticias")
}

model Biblioteca {
  id        Int                  @id @default(autoincrement())
  tipo      String
  titulo    String
  autor     String
  categoria String
  tags      String[]             @default([])
  archivo   String
  portada   String?
  activa    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  destacado Boolean              @default(false)
  vistas    Int                  @default(0)
  favoritos BibliotecaFavorito[]

  @@map("biblioteca")
}

model BibliotecaCategoria {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  createdAt DateTime @default(now())

  @@map("biblioteca_categorias")
}

model BibliotecaFavorito {
  id           Int        @id @default(autoincrement())
  expediente   String
  bibliotecaId Int        @map("biblioteca_id")
  createdAt    DateTime   @default(now())
  biblioteca   Biblioteca @relation(fields: [bibliotecaId], references: [id], onDelete: Cascade)

  @@unique([expediente, bibliotecaId])
  @@map("biblioteca_favoritos")
}

model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  fecha       DateTime
  tipo        String   @default("institucional")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("eventos")
}

model Producto {
  id            Int      @id @default(autoincrement())
  nombre        String
  precio        Float
  stock         Int
  habilitado    Boolean  @default(true)
  limiteMensual Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pedidos       Pedido[]

  @@map("productos")
}

model Pedido {
  id          Int      @id @default(autoincrement())
  expediente  String
  productoId  Int      @map("producto_id")
  cantidad    Int      @default(1)
  metodoPago  String
  comprobante String?
  estado      String   @default("pendiente")
  observacion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  exportado   Boolean  @default(false)
  mpPaymentId String?  @map("mp_payment_id")
  producto    Producto @relation(fields: [productoId], references: [id])

  @@map("pedidos")
}

model Notificacion {
  id         Int      @id @default(autoincrement())
  expediente String
  titulo     String
  mensaje    String
  tipo       String   @default("general")
  leida      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("notificaciones")
}

model FaqCategoria {
  id        Int      @id @default(autoincrement())
  nombre    String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  faqs      Faq[]

  @@map("faq_categorias")
}

model Faq {
  id          Int          @id @default(autoincrement())
  categoriaId Int          @map("categoria_id")
  pregunta    String
  respuesta   String
  orden       Int          @default(0)
  createdAt   DateTime     @default(now())
  categoria   FaqCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@map("faqs")
}

model Conversacion {
  id         Int           @id @default(autoincrement())
  expediente String
  asunto     String
  archivada  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  mensajes   MensajeChat[]

  @@map("conversaciones")
}

model MensajeChat {
  id             Int          @id @default(autoincrement())
  conversacionId Int          @map("conversacion_id")
  de             String
  contenido      String
  leido          Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@map("mensajes_chat")
}

model FirmaAutoridad {
  id            Int      @id @default(autoincrement())
  cargo         String
  nombre        String?
  firma         String?
  updatedAt     DateTime @updatedAt
  enCertificado Boolean  @default(false)
  enCredencial  Boolean  @default(false)
  orden         Int      @default(0)

  @@map("firmas_autoridades")
}

model EnvioMasivo {
  id            Int                       @id @default(autoincrement())
  asunto        String
  contenido     String
  adjuntoUrl    String?                   @map("adjunto_url")
  adjuntoTipo   String?                   @map("adjunto_tipo")
  totalEnvios   Int                       @default(0)
  createdAt     DateTime                  @default(now())
  destinatarios EnvioMasivoDestinatario[]

  @@map("envios_masivos")
}

model EmailMarketing {
  id            Int                          @id @default(autoincrement())
  asunto        String
  contenido     String
  enviarATodos  Boolean                      @default(false) @map("enviar_a_todos")
  adminNombre   String                       @map("admin_nombre")
  totalEnvios   Int                          @default(0)
  cancelada     Boolean                      @default(false)
  createdAt     DateTime                     @default(now())
  destinatarios EmailMarketingDestinatario[]

  @@map("email_marketing")
}

model EmailMarketingDestinatario {
  id           Int            @id @default(autoincrement())
  campanaId    Int            @map("campana_id")
  expediente   String
  email        String
  estado       String         @default("pendiente")
  error        String?
  enviadoAt    DateTime?      @map("enviado_at")
  campana      EmailMarketing @relation(fields: [campanaId], references: [id], onDelete: Cascade)

  @@map("email_marketing_destinatarios")
}

model EnvioMasivoDestinatario {
  id         Int         @id @default(autoincrement())
  envioId    Int         @map("envio_id")
  expediente String
  leido      Boolean     @default(false)
  leidoAt    DateTime?   @map("leido_at")
  envio      EnvioMasivo @relation(fields: [envioId], references: [id], onDelete: Cascade)

  @@unique([envioId, expediente])
  @@map("envios_masivos_destinatarios")
}

model AdminLog {
  id          Int      @id @default(autoincrement())
  adminId     Int
  adminNombre String
  expediente  String?
  modulo      String
  accion      String
  detalle     Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([expediente])
  @@index([modulo])
  @@index([createdAt])
  @@map("admin_log")
}

model TribunalEtica {
  id         Int       @id @default(autoincrement())
  expediente String
  texto      String
  inicio     DateTime?
  fin        DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("tribunal_etica")
}

model RepositorioCategoria {
  id        Int                  @id @default(autoincrement())
  nombre    String
  orden     Int                  @default(0)
  createdAt DateTime             @default(now())
  archivos  RepositorioArchivo[]

  @@map("repositorio_categorias")
}

model CambioDatos {
  id         Int      @id @default(autoincrement())
  expediente String
  campos     Json
  leido      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("cambios_datos")
}

model RepositorioArchivo {
  id          Int                  @id @default(autoincrement())
  categoriaId Int                  @map("categoria_id")
  nombre      String
  descripcion String?
  archivo     String
  tipo        String               @default("pdf")
  tamano      String?
  descargas   Int                  @default(0)
  createdAt   DateTime             @default(now())
  categoria   RepositorioCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@map("repositorio_archivos")
}

model PagoPendiente {
  id          Int      @id @default(autoincrement())
  expediente  String
  tipo        String
  ref         String
  monto       Float
  comprobante String
  estado      String   @default("pendiente")
  nota        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pagos_pendientes")
}

model RecuperacionToken {
  id         Int      @id @default(autoincrement())
  expediente String
  token      String
  expira     DateTime
  usado      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("recuperacion_tokens")
}

model HistorialMatricula {
  id           Int       @id @default(autoincrement())
  expediente   String
  accion       String
  comentario   String
  adminNombre  String?
  createdAt    DateTime  @default(now())
  motivoNombre String?
  motivoId     Int?
  motivoCobra  Boolean?
  fechaFin     DateTime? @map("fecha_fin")
  fechaInicio  DateTime? @map("fecha_inicio")

  @@index([expediente])
  @@map("historial_matricula")
}

model MotivoSuspension {
  id          Int      @id @default(autoincrement())
  nombre      String
  tipo        String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  aplicaMulta Boolean  @default(false)

  @@map("motivos_suspension")
}

model SolicitudRehabilitacion {
  id            Int      @id @default(autoincrement())
  expediente    String
  estado        String   @default("borrador")
  respuesta     String?
  adminNombre   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deudaOriginal Float?
  p1Comprobante String?
  p1Metodo      String?
  p1MpPaymentId String?
  p1Ok          Boolean  @default(false)
  p2Desde       String?
  p2Ok          Boolean  @default(false)
  p2Razon       String?
  p3Ok          Boolean  @default(false)
  p3Pdf         String?
  p4Dni         String?
  p4Doc         String?
  p4Ok          Boolean  @default(false)
  p4Tipo        String?
  p5Comprobante String?
  p5JusAmount   Float?
  p5Metodo      String?
  p5MpPaymentId String?
  p5Ok          Boolean  @default(false)
  p5Pesos       Float?
  pasoActual    Int      @default(1)

  @@index([expediente])
  @@map("solicitudes_rehabilitacion")
}

model FacturaSantaFe {
  id         Int      @id @default(autoincrement())
  tipo       String
  periodo    String
  expediente String
  cod        String
  factura    String?
  archivo    String
  createdAt  DateTime @default(now())

  @@index([expediente])
  @@index([tipo])
  @@map("facturas_santa_fe")
}

model Tutorial {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  videoUrl    String
  tipo        String   @default("url")
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tutoriales")
}

model Fiador {
  id               Int      @id @default(autoincrement())
  expediente       String   @unique
  fiadorExpediente String   @map("fiador_expediente")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("fiadores")
}

model TurneroFiscal {
  id        Int      @id @default(autoincrement())
  titulo    String
  archivo   String
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("turnero_fiscales")
}
