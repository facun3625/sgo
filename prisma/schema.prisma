// SGO - Sistema de Gestión
// Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  apellido    String
  nombre      String
  expediente  String?  @unique
  cod         String?  @unique
  password    String
  status      String   @default("active")
  accessLevel String   @default("user") @map("access_level")
  registered  Int      @default(1)
  image       String?
  signature   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

model Dato {
  id                 Int       @id @default(autoincrement())
  cod                String    @unique
  apellido           String
  nombre             String
  domicilioLegal     String?   @map("domicilio_legal")
  postalLegal        String?   @map("postal_legal")
  localidadLegal     String?   @map("localidad_legal")
  telefonosLegal     String?   @map("telefonos_legal")
  emailLegal         String?   @map("email_legal")
  expediente         String?
  folio              String?
  tipo               String?
  documento          String?
  tomo               String?
  domicilioReal      String?   @map("domicilio_real")
  postalReal         String?   @map("postal_real")
  localidadReal      String?   @map("localidad_real")
  codMovilLegal      String?   @map("cod_movil_legal")
  movilLegal         String?   @map("movil_legal")
  telefonosReal      String?   @map("telefonos_real")
  codMovilReal       String?   @map("cod_movil_real")
  movilReal          String?   @map("movil_real")
  emailReal          String?   @map("email_real")
  provinciaReal      String?   @map("provincia_real")
  fechaMatriculacion DateTime? @map("fecha_matriculacion")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("datos")
}

model Deuda {
  id         Int    @id @default(autoincrement())
  expediente String
  monto      Float

  @@map("deudas")
}

model MatriculaAnual {
  id         Int    @id @default(autoincrement())
  expediente String
  monto      Float

  @@map("matricula_anual")
}

model MatriculaMensual {
  id         Int    @id @default(autoincrement())
  expediente String
  monto      Float

  @@map("matricula_mensual")
}


model PagoAnual {
  id         Int    @id @default(autoincrement())
  expediente String

  @@map("pago_anual")
}

model Solicitud {
  id              Int      @id @default(autoincrement())
  expediente      String
  tipo            String // Ejemplo: "Certificado de Matriculación", "SISFE", etc.
  fecha           DateTime @default(now())
  estado          String   @default("pendiente") // pendiente, completada, rechazada
  presentarAnte   String?
  emailLegal      String?
  adjunto         String?  // Ruta o URL del archivo adjunto (PDF/Imagen)
  detalles        Json?    // Para guardar datos específicos como CUIT
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("solicitudes")
}

model AdhesionDebito {
  id              Int      @id @default(autoincrement())
  expediente      String
  tipoAdhesion    String   // "CBU" o "Tarjeta"
  estado          String   @default("pendiente") // pendiente, aprobada, rechazada
  dniFrontal      String?  // Ruta o URL del archivo
  constanciaCbu   String?  // Ruta o URL del archivo (Solo para CBU)
  frontalTarjeta  String?  // Ruta o URL del archivo (Solo para Tarjeta)
  terminosAceptados Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("adhesiones_debito")
}

model Curso {
  id                     Int               @id @default(autoincrement())
  titulo                 String
  descripcion            String
  organizador            String?
  fecha                  DateTime
  fechaFin               DateTime?
  hora                   String?
  lugar                  String?
  imagen                 String?
  modalidad              String            @default("Presencial") // Presencial / Virtual / Híbrida
  fechaLimiteInscripcion DateTime?
  activo                 Boolean           @default(true)
  mostrarEnCalendario    Boolean           @default(false)
  opciones               CursoOpcion[]
  inscripciones          InscripcionCurso[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@map("cursos")
}

model CursoOpcion {
  id            Int               @id @default(autoincrement())
  cursoId       Int               @map("curso_id")
  nombre        String
  precio        Float             @default(0)
  cupo          Int               @default(0)
  inscritos     Int               @default(0)
  curso         Curso             @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  inscripciones InscripcionCurso[]
  createdAt     DateTime          @default(now())

  @@map("curso_opciones")
}

model InscripcionCurso {
  id          Int          @id @default(autoincrement())
  expediente  String
  cursoId     Int          @map("curso_id")
  opcionId    Int?         @map("opcion_id")
  estado      String       @default("pendiente_pago")
  metodoPago  String?      @map("metodo_pago")
  curso       Curso        @relation(fields: [cursoId], references: [id])
  opcion      CursoOpcion? @relation(fields: [opcionId], references: [id])
  fecha       DateTime     @default(now())

  @@map("inscripciones_cursos")
}

model Noticia {
  id          Int      @id @default(autoincrement())
  titulo      String
  contenido   String
  imagen      String?
  imagenes    String[] @default([])
  activa      Boolean  @default(true)
  destacada   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("noticias")
}

model Biblioteca {
  id          Int      @id @default(autoincrement())
  tipo        String   // "libro" | "jurisprudencia"
  titulo      String
  autor       String
  categoria   String
  tags        String[] @default([])
  archivo     String   // URL del PDF
  portada     String?  // URL imagen opcional
  activa      Boolean  @default(true)
  destacado   Boolean  @default(false)
  vistas      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  favoritos   BibliotecaFavorito[]

  @@map("biblioteca")
}

model BibliotecaCategoria {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  createdAt DateTime @default(now())

  @@map("biblioteca_categorias")
}

model BibliotecaFavorito {
  id           Int       @id @default(autoincrement())
  expediente   String
  bibliotecaId Int       @map("biblioteca_id")
  biblioteca   Biblioteca @relation(fields: [bibliotecaId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@unique([expediente, bibliotecaId])
  @@map("biblioteca_favoritos")
}

model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  fecha       DateTime
  tipo        String   @default("institucional") // institucional, social, feriado, curso
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("eventos")
}

model TokenConfig {
  id            Int      @id @default(autoincrement())
  precio        Float
  stock         Int
  limiteMensual Int      @default(1)
  activo        Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("token_config")
}

model TokenPedido {
  id          Int      @id @default(autoincrement())
  expediente  String
  cantidad    Int      @default(1)
  metodoPago  String   // "mercadopago" | "transferencia" | "efectivo"
  comprobante String?  // URL — solo transferencia
  estado      String   @default("pendiente") // pendiente | aprobado | entregado | cancelado
  observacion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("token_pedidos")
}

model Notificacion {
  id         Int      @id @default(autoincrement())
  expediente String
  titulo     String
  mensaje    String
  tipo       String   @default("general") // general | pedido
  leida      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("notificaciones")
}

model FaqCategoria {
  id        Int      @id @default(autoincrement())
  nombre    String
  orden     Int      @default(0)
  faqs      Faq[]
  createdAt DateTime @default(now())

  @@map("faq_categorias")
}

model Faq {
  id          Int          @id @default(autoincrement())
  categoriaId Int          @map("categoria_id")
  categoria   FaqCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  pregunta    String
  respuesta   String
  orden       Int          @default(0)
  createdAt   DateTime     @default(now())

  @@map("faqs")
}

model Conversacion {
  id         Int           @id @default(autoincrement())
  expediente String
  asunto     String
  archivada  Boolean       @default(false)
  mensajes   MensajeChat[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("conversaciones")
}

model MensajeChat {
  id             Int          @id @default(autoincrement())
  conversacionId Int          @map("conversacion_id")
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  de             String       // "admin" | "user"
  contenido      String
  leido          Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("mensajes_chat")
}

model FirmaAutoridad {
  id              Int      @id @default(autoincrement())
  cargo           String
  nombre          String?
  firma           String?
  enCredencial    Boolean  @default(false)
  enCertificado   Boolean  @default(false)
  orden           Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@map("firmas_autoridades")
}

model EnvioMasivo {
  id            Int                       @id @default(autoincrement())
  asunto        String
  contenido     String
  totalEnvios   Int                       @default(0)
  destinatarios EnvioMasivoDestinatario[]
  createdAt     DateTime                  @default(now())

  @@map("envios_masivos")
}

model EnvioMasivoDestinatario {
  id         Int         @id @default(autoincrement())
  envioId    Int         @map("envio_id")
  envio      EnvioMasivo @relation(fields: [envioId], references: [id], onDelete: Cascade)
  expediente String
  leido      Boolean     @default(false)
  leidoAt    DateTime?   @map("leido_at")

  @@unique([envioId, expediente])
  @@map("envios_masivos_destinatarios")
}

model TribunalEtica {
  id          Int      @id @default(autoincrement())
  expediente  String
  texto       String
  inicio      DateTime
  fin         DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tribunal_etica")
}

model RepositorioCategoria {
  id        Int                  @id @default(autoincrement())
  nombre    String
  orden     Int                  @default(0)
  archivos  RepositorioArchivo[]
  createdAt DateTime             @default(now())

  @@map("repositorio_categorias")
}

model RepositorioArchivo {
  id          Int                  @id @default(autoincrement())
  categoriaId Int                  @map("categoria_id")
  categoria   RepositorioCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  archivo     String
  tipo        String               @default("pdf")
  tamano      String?
  descargas   Int                  @default(0)
  createdAt   DateTime             @default(now())

  @@map("repositorio_archivos")
}
