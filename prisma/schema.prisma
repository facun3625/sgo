// SGO - Sistema de Gestión
// Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  apellido    String
  nombre      String
  expediente  String?  @unique
  cod         String?  @unique
  password    String
  status         String    @default("active")
  suspendedUntil DateTime? @map("suspended_until")
  accessLevel    String    @default("user") @map("access_level")
  registered  Int      @default(1)
  image       String?
  permisos    String   @default("[]")
  signature   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

model Dato {
  id                 Int       @id @default(autoincrement())
  cod                String    @unique
  apellido           String
  nombre             String
  domicilioLegal     String?   @map("domicilio_legal")
  postalLegal        String?   @map("postal_legal")
  localidadLegal     String?   @map("localidad_legal")
  telefonosLegal     String?   @map("telefonos_legal")
  emailLegal         String?   @map("email_legal")
  expediente         String?
  folio              String?
  tipo               String?
  cuil               String?
  documento          String?
  tomo               String?
  domicilioReal      String?   @map("domicilio_real")
  postalReal         String?   @map("postal_real")
  localidadReal      String?   @map("localidad_real")
  codMovilLegal      String?   @map("cod_movil_legal")
  movilLegal         String?   @map("movil_legal")
  telefonosReal      String?   @map("telefonos_real")
  codMovilReal       String?   @map("cod_movil_real")
  movilReal          String?   @map("movil_real")
  emailReal          String?   @map("email_real")
  provinciaReal      String?   @map("provincia_real")
  fechaMatriculacion DateTime? @map("fecha_matriculacion")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("datos")
}

model Deuda {
  id         Int    @id @default(autoincrement())
  expediente String
  monto      Float

  @@map("deudas")
}

model DeudaPagada {
  id          Int      @id @default(autoincrement())
  expediente  String
  monto       Float
  mpPaymentId String?  @map("mp_payment_id")
  metodoPago  String   @default("mercadopago")
  fechaPago   DateTime @default(now()) @map("fecha_pago")
  exportado   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([expediente])
  @@map("deudas_pagadas")
}

model Config {
  id        Int      @id @default(autoincrement())
  clave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt

  @@map("config")
}

model CuotaMensual {
  id          Int       @id @default(autoincrement())
  expediente  String
  periodo     String    // "2026-03"
  monto       Float
  estado      String    @default("pendiente") // pendiente / pagado
  fechaPago   DateTime?
  metodoPago  String?   // mercadopago | transferencia | home_banking
  mpPaymentId String?   @map("mp_payment_id")
  exportado   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([expediente, periodo])
  @@map("cuotas_mensuales")
}

model PagoAnual {
  id          Int       @id @default(autoincrement())
  expediente  String
  mpPaymentId String?   @map("mp_payment_id")
  fechaPago   DateTime?
  exportado   Boolean   @default(false)

  @@map("pago_anual")
}

model Solicitud {
  id              Int      @id @default(autoincrement())
  expediente      String
  tipo            String // Ejemplo: "Certificado de Matriculación", "SISFE", etc.
  fecha           DateTime @default(now())
  estado          String   @default("pendiente") // pendiente, completada, rechazada
  presentarAnte   String?
  emailLegal      String?
  adjunto         String?  // Ruta o URL del archivo adjunto (PDF/Imagen)
  detalles        Json?    // Para guardar datos específicos como CUIT
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("solicitudes")
}

model AdhesionDebito {
  id              Int      @id @default(autoincrement())
  expediente      String
  tipoAdhesion    String   // "CBU" o "Tarjeta"
  estado          String   @default("pendiente") // pendiente, aprobada, rechazada
  dniFrontal      String?  // Ruta o URL del archivo
  constanciaCbu   String?  // Ruta o URL del archivo (Solo para CBU)
  frontalTarjeta  String?  // Ruta o URL del archivo (Solo para Tarjeta)
  terminosAceptados Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("adhesiones_debito")
}

model Curso {
  id                     Int               @id @default(autoincrement())
  titulo                 String
  descripcion            String
  organizador            String?
  fecha                  DateTime
  fechaFin               DateTime?
  hora                   String?
  lugar                  String?
  imagen                 String?
  modalidad              String            @default("Presencial") // Presencial / Virtual / Híbrida
  fechaLimiteInscripcion DateTime?
  activo                 Boolean           @default(true)
  mostrarEnCalendario    Boolean           @default(false)
  // Asistencia
  tipoAsistencia         String            @default("ninguna") @map("tipo_asistencia") // "ninguna" | "por_dia" | "global"
  porcentajeMin          Float?            @map("porcentaje_min") // para "global": % mínimo de sesiones asistidas
  diasMinimos            Int?              @map("dias_minimos")   // para "por_dia": mínimo de días presentes
  // Certificado
  certTexto              String?           @map("cert_texto")     // cuerpo del texto del certificado
  certCabecera           String?           @map("cert_cabecera")  // URL imagen cabecera
  certFirmasIds          Int[]             @default([]) @map("cert_firmas_ids") // IDs de FirmaAutoridad
  opciones               CursoOpcion[]
  inscripciones          InscripcionCurso[]
  dias                   CursoDia[]
  sesiones               SesionAsistencia[]
  certificados           CertificadoCurso[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@map("cursos")
}

model CursoDia {
  id        Int                @id @default(autoincrement())
  cursoId   Int                @map("curso_id")
  curso     Curso              @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  fecha     DateTime
  nombre    String?
  orden     Int                @default(0)
  sesiones  SesionAsistencia[]
  createdAt DateTime           @default(now())

  @@map("curso_dias")
}

model SesionAsistencia {
  id          Int               @id @default(autoincrement())
  cursoId     Int               @map("curso_id")
  curso       Curso             @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  diaId       Int?              @map("dia_id")
  dia         CursoDia?         @relation(fields: [diaId], references: [id])
  token       String            @unique @default(uuid())
  activa      Boolean           @default(true)
  asistencias AsistenciaCurso[]
  createdAt   DateTime          @default(now())

  @@map("sesiones_asistencia")
}

model AsistenciaCurso {
  id         Int              @id @default(autoincrement())
  sesionId   Int              @map("sesion_id")
  sesion     SesionAsistencia @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  expediente String
  createdAt  DateTime         @default(now())

  @@unique([sesionId, expediente])
  @@map("asistencias_cursos")
}

model CertificadoCurso {
  id         Int      @id @default(autoincrement())
  expediente String
  cursoId    Int      @map("curso_id")
  curso      Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  emitidoAt  DateTime @default(now())

  @@unique([expediente, cursoId])
  @@map("certificados_cursos")
}

model CursoOpcion {
  id            Int               @id @default(autoincrement())
  cursoId       Int               @map("curso_id")
  nombre        String
  precio        Float             @default(0)
  cupo          Int               @default(0)
  inscritos     Int               @default(0)
  curso         Curso             @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  inscripciones InscripcionCurso[]
  createdAt     DateTime          @default(now())

  @@map("curso_opciones")
}

model InscripcionCurso {
  id          Int          @id @default(autoincrement())
  expediente  String
  cursoId     Int          @map("curso_id")
  opcionId    Int?         @map("opcion_id")
  estado      String       @default("pendiente_pago")
  metodoPago  String?      @map("metodo_pago")
  mpPaymentId String?      @map("mp_payment_id")
  fechaPago   DateTime?    @map("fecha_pago")
  curso       Curso        @relation(fields: [cursoId], references: [id])
  opcion      CursoOpcion? @relation(fields: [opcionId], references: [id])
  fecha       DateTime     @default(now())

  @@map("inscripciones_cursos")
}

model Noticia {
  id          Int      @id @default(autoincrement())
  titulo      String
  contenido   String
  imagen      String?
  imagenes    String[] @default([])
  activa      Boolean  @default(true)
  destacada   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("noticias")
}

model Biblioteca {
  id          Int      @id @default(autoincrement())
  tipo        String   // "libro" | "jurisprudencia"
  titulo      String
  autor       String
  categoria   String
  tags        String[] @default([])
  archivo     String   // URL del PDF
  portada     String?  // URL imagen opcional
  activa      Boolean  @default(true)
  destacado   Boolean  @default(false)
  vistas      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  favoritos   BibliotecaFavorito[]

  @@map("biblioteca")
}

model BibliotecaCategoria {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  createdAt DateTime @default(now())

  @@map("biblioteca_categorias")
}

model BibliotecaFavorito {
  id           Int       @id @default(autoincrement())
  expediente   String
  bibliotecaId Int       @map("biblioteca_id")
  biblioteca   Biblioteca @relation(fields: [bibliotecaId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@unique([expediente, bibliotecaId])
  @@map("biblioteca_favoritos")
}

model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  fecha       DateTime
  tipo        String   @default("institucional") // institucional, social, feriado, curso
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("eventos")
}

model Producto {
  id            Int      @id @default(autoincrement())
  nombre        String
  precio        Float
  stock         Int
  habilitado    Boolean  @default(true)
  limiteMensual Int?     // opcional — null = sin límite
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pedidos       Pedido[]

  @@map("productos")
}

model Pedido {
  id          Int      @id @default(autoincrement())
  expediente  String
  productoId  Int      @map("producto_id")
  producto    Producto @relation(fields: [productoId], references: [id])
  cantidad    Int      @default(1)
  metodoPago  String   // "mercadopago" | "transferencia" | "efectivo"
  comprobante String?  // URL — solo transferencia
  estado      String   @default("pendiente") // pendiente | aprobado | entregado | cancelado
  observacion String?
  mpPaymentId String?  @map("mp_payment_id")
  exportado   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pedidos")
}

model Notificacion {
  id         Int      @id @default(autoincrement())
  expediente String
  titulo     String
  mensaje    String
  tipo       String   @default("general") // general | pedido
  leida      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("notificaciones")
}

model FaqCategoria {
  id        Int      @id @default(autoincrement())
  nombre    String
  orden     Int      @default(0)
  faqs      Faq[]
  createdAt DateTime @default(now())

  @@map("faq_categorias")
}

model Faq {
  id          Int          @id @default(autoincrement())
  categoriaId Int          @map("categoria_id")
  categoria   FaqCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  pregunta    String
  respuesta   String
  orden       Int          @default(0)
  createdAt   DateTime     @default(now())

  @@map("faqs")
}

model Conversacion {
  id         Int           @id @default(autoincrement())
  expediente String
  asunto     String
  archivada  Boolean       @default(false)
  mensajes   MensajeChat[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("conversaciones")
}

model MensajeChat {
  id             Int          @id @default(autoincrement())
  conversacionId Int          @map("conversacion_id")
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  de             String       // "admin" | "user"
  contenido      String
  leido          Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("mensajes_chat")
}

model FirmaAutoridad {
  id              Int      @id @default(autoincrement())
  cargo           String
  nombre          String?
  firma           String?
  enCredencial    Boolean  @default(false)
  enCertificado   Boolean  @default(false)
  orden           Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@map("firmas_autoridades")
}

model EnvioMasivo {
  id            Int                       @id @default(autoincrement())
  asunto        String
  contenido     String
  totalEnvios   Int                       @default(0)
  destinatarios EnvioMasivoDestinatario[]
  createdAt     DateTime                  @default(now())

  @@map("envios_masivos")
}

model EnvioMasivoDestinatario {
  id         Int         @id @default(autoincrement())
  envioId    Int         @map("envio_id")
  envio      EnvioMasivo @relation(fields: [envioId], references: [id], onDelete: Cascade)
  expediente String
  leido      Boolean     @default(false)
  leidoAt    DateTime?   @map("leido_at")

  @@unique([envioId, expediente])
  @@map("envios_masivos_destinatarios")
}

model TribunalEtica {
  id          Int      @id @default(autoincrement())
  expediente  String
  texto       String
  inicio      DateTime?
  fin         DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tribunal_etica")
}

model RepositorioCategoria {
  id        Int                  @id @default(autoincrement())
  nombre    String
  orden     Int                  @default(0)
  archivos  RepositorioArchivo[]
  createdAt DateTime             @default(now())

  @@map("repositorio_categorias")
}

model CambioDatos {
  id          Int      @id @default(autoincrement())
  expediente  String
  campos      Json     // { fieldName: { anterior: string, nuevo: string } }
  leido       Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("cambios_datos")
}

model RepositorioArchivo {
  id          Int                  @id @default(autoincrement())
  categoriaId Int                  @map("categoria_id")
  categoria   RepositorioCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  archivo     String
  tipo        String               @default("pdf")
  tamano      String?
  descargas   Int                  @default(0)
  createdAt   DateTime             @default(now())

  @@map("repositorio_archivos")
}

model PagoPendiente {
  id          Int      @id @default(autoincrement())
  expediente  String
  tipo        String   // "matricula_mensual" | "matricula_anual" | "deuda" | "curso"
  ref         String   // cuotaId / "anual" / comma-separated deudaIds / inscripcionId
  monto       Float
  comprobante String   // URL del comprobante
  estado      String   @default("pendiente") // "pendiente" | "aprobado" | "rechazado"
  nota        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pagos_pendientes")
}

model RecuperacionToken {
  id         Int      @id @default(autoincrement())
  expediente String
  token      String
  expira     DateTime
  usado      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("recuperacion_tokens")
}

model HistorialMatricula {
  id           Int      @id @default(autoincrement())
  expediente   String
  accion       String   // "suspension" | "habilitacion" | "cancelacion"
  comentario   String
  motivoNombre String?
  motivoId     Int?
  motivoCobra  Boolean?  // snapshot: si el motivo cobra al rehabilitar
  fechaInicio  DateTime? @map("fecha_inicio")
  fechaFin     DateTime? @map("fecha_fin")
  adminNombre  String?
  createdAt    DateTime  @default(now())

  @@index([expediente])
  @@map("historial_matricula")
}

model MotivoSuspension {
  id          Int      @id @default(autoincrement())
  nombre      String
  tipo        String   // "suspension" | "cancelacion" | "ambos"
  aplicaMulta Boolean  @default(false) // cobra al rehabilitar (usa valor global JUS)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("motivos_suspension")
}

model SolicitudRehabilitacion {
  id            Int      @id @default(autoincrement())
  expediente    String
  estado        String   @default("borrador") // borrador | pendiente | aprobada | rechazada
  pasoActual    Int      @default(1)

  // Paso 1 — Pago de deuda
  deudaOriginal Float?   // snapshot al iniciar
  p1Metodo      String?  // sin_deuda | mercadopago | transferencia
  p1Comprobante String?
  p1MpPaymentId String?
  p1Ok          Boolean  @default(false)

  // Paso 2 — Formulario
  p2Desde       String?  // "a partir de"
  p2Razon       String?  // "en razón de"
  p2Ok          Boolean  @default(false)

  // Paso 3 — PDF Reincidencia
  p3Pdf         String?
  p3Ok          Boolean  @default(false)

  // Paso 4 — Adhesión a débito
  p4Tipo        String?  // CBU | Tarjeta
  p4Dni         String?
  p4Doc         String?
  p4Ok          Boolean  @default(false)

  // Paso 5 — Costo rehabilitación
  p5JusAmount   Float?
  p5Pesos       Float?
  p5Metodo      String?  // mercadopago | transferencia
  p5Comprobante String?
  p5MpPaymentId String?
  p5Ok          Boolean  @default(false)

  respuesta     String?
  adminNombre   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expediente])
  @@map("solicitudes_rehabilitacion")
}

model FacturaSantaFe {
  id         Int      @id @default(autoincrement())
  tipo       String   // "mensual" | "anual" | "deuda"
  periodo    String
  expediente String
  cod        String
  factura    String?
  archivo    String
  createdAt  DateTime @default(now())

  @@index([expediente])
  @@index([tipo])
  @@map("facturas_santa_fe")
}

model Tutorial {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  videoUrl    String
  tipo        String   @default("url") // "url" | "embed"
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tutoriales")
}

model Fiador {
  id               Int      @id @default(autoincrement())
  expediente       String   @unique
  fiadorExpediente String   @map("fiador_expediente")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("fiadores")
}
